{
 "id": "synth-weekly-1",
 "prompt": "reports 폴더의 팀별 주간 보고를 모두 읽고 summary.md 를 작성하세요. '## 요약' 절에는 예산 집행률이 가장 높은 팀과 그 비율(예: 개발 87%)을 한 줄로, '## 위험' 절에는 위험이 있는 팀마다 '팀명: 위험' 한 줄씩 적으세요(위험이 '없음'인 팀은 빼세요).",
 "checks": [
  {
   "kind": "file_exists",
   "path": "summary.md",
   "required": true
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "^#+\\s*요약",
   "format": true,
   "name": "has-summary-heading"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "^#+\\s*위험",
   "format": true,
   "name": "has-risk-heading"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "text": "개발",
   "name": "mentions-top-team"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "개발[^\\n]*73%",
   "name": "top-team-rate"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "영업[^\\n]*예산 초과",
   "name": "risk-영업"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "개발[^\\n]*인력 부족",
   "name": "risk-개발"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "운영[^\\n]*일정 지연",
   "name": "risk-운영"
  },
  {
   "kind": "file_contains",
   "path": "summary.md",
   "regex": "재무[^\\n]*인력 부족",
   "name": "risk-재무"
  }
 ],
 "files": {
  "reports/영업.md": "# 영업팀 주간 보고\n\n- 예산 집행률: 61%\n- 주요 위험: 예산 초과\n- 다음 주 계획: 정기 점검\n",
  "reports/개발.md": "# 개발팀 주간 보고\n\n- 예산 집행률: 73%\n- 주요 위험: 인력 부족\n- 다음 주 계획: 정기 점검\n",
  "reports/운영.md": "# 운영팀 주간 보고\n\n- 예산 집행률: 46%\n- 주요 위험: 일정 지연\n- 다음 주 계획: 정기 점검\n",
  "reports/재무.md": "# 재무팀 주간 보고\n\n- 예산 집행률: 71%\n- 주요 위험: 인력 부족\n- 다음 주 계획: 정기 점검\n"
 },
 "tags": [
  "synthesis"
 ]
}
